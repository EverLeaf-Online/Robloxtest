{
  "name": "ScrapToBotTests",
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "$properties": {
        "LoadStringEnabled": true
      },
      "ServerUnderTest": {
        "$className": "Folder",
        "jest.config": {
          "$path": "src/shared/jest.config.lua"
        },
        "Content": {
          "$path": "src/server/Content"
        },
        "Data": {
          "$path": "src/server/Data"
        },
        "Domain": {
          "$path": "src/server/Domain"
        },
        "Presentation": {
          "$path": "src/server/Presentation"
        },
        "Services": {
          "$className": "Folder",
          "EconomyService": {
            "$path": "src/server/Services/EconomyService.lua"
          },
          "RateLimiter": {
            "$path": "src/server/Services/RateLimiter.lua"
          }
        },
        "Tests": {
          "$path": "src/server/__tests__"
        }
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": {
          "optional": "Packages"
        }
      },
      "DevPackages": {
        "$path": {
          "optional": "DevPackages"
        }
      }
    }
  }
}
